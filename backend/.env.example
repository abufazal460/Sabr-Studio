# Copy to backend/.env and fill real values. NEVER commit real secrets.
NODE_ENV=development
PORT=3000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# EmailJS (server-side ONLY — backend reads these; never use VITE_* for them).
# All four are required for enquiry emails; if any is missing the API returns
# 503 { success:false, code:"EMAIL_CONFIG_MISSING" } instead of false success.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

