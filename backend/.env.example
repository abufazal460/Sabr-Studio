# Server & Hosting
PORT=3000
NODE_ENV=development
SERVE_FRONTEND=true

# Database & Authentication
# Production MUST point at the sabrstudio database. Either include /sabrstudio
# in the URI path OR leave the path empty and set MONGODB_DB_NAME=sabrstudio
# (db.js pins the production name and refuses the legacy `test` database).
MONGODB_URI=
MONGODB_DB_NAME=sabrstudio
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=sabrstudio

# Cookies & Domain
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
EMAILJS_ORIGIN=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=

# EmailJS
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Sign-In (the ONLY customer authentication method)
# Only the client id is required: the browser sends an opaque Google ID token
# and the backend verifies it against Google's public JWKS (RS256).
# The client secret is NOT used by this flow and must never be exposed.
GOOGLE_CLIENT_ID=
