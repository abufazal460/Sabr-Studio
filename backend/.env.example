# Server
NODE_ENV=development
PORT=3000

# Database (MongoDB Atlas SRV string). Leave empty to run on in-memory fallback data.
MONGODB_URI=

# Runtime fallback storage directory (JSON files written when MongoDB is unreachable).
# Leave empty for the default <project>/data/fallback; serverless runtimes use /tmp.
FALLBACK_DIR=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Optional override for the seeded local admin password
ADMIN_PASSWORD=

# Cookies
# COOKIE_SECURE=true in production (HTTPS). Keep false for local http development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — comma-separated allow-list, never "*". Same-origin in production.
# Dev example: http://localhost:5173,http://localhost:3000
CORS_ORIGIN=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (EmailJS)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
