# Copy to backend/.env and fill real values. NEVER commit real secrets.
# These are SERVER-ONLY. None of them may be exposed via VITE_* to the browser.

# --- Runtime ---
NODE_ENV=development
# Hostinger injects the assigned listening port via PORT (the panel's 65002 is
# this internal port). Do NOT hardcode it in code. PORT is read first.
PORT=3000
# Optional overrides:
# BACKEND_PORT=            # alternate port (local dev / if PORT is unusable)
# HOST=                    # bind address; unset = all interfaces (0.0.0.0/::)
# SERVE_FRONTEND=true      # prod only: Express serves ../frontend/dist (same-domain SPA)
# FALLBACK_DIR=            # override dir for dev fallback JSON (never used in prod)

# --- Database (MongoDB Atlas) ---
MONGODB_URI=

# --- Auth / sessions ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Operator-set admin bootstrap password. REQUIRED in production: with the
# hardcoded backdoor passwords removed, admin login uses the bcrypt hash in
# Atlas and/or this value. Use a long unique secret. Never commit the real one.
ADMIN_PASSWORD=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS (comma-separated allowed frontend origins) ---
CORS_ORIGIN=http://localhost:5173

# --- Razorpay payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook HMAC secret (Razorpay Dashboard > Webhooks). Used to verify
# server-to-server payment webhooks. Optional if you rely on checkout signature.
RAZORPAY_WEBHOOK_SECRET=

# --- Google Sign-In (server-side ID-token verification) ---
# OAuth 2.0 Client ID (Web application) from Google Cloud Console. Without it,
# /api/customer/google fails closed with 503 (never trusts browser-submitted ids).
GOOGLE_CLIENT_ID=

# --- Phone OTP login (SMS provider) ---
# Twilio credentials. Without all three, /api/customer/request-otp fails closed
# with 503 (never simulates a sent/verified OTP).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cloudinary (admin image uploads) ---
# Without all three, /api/admin/uploads returns 503 (never fabricates a URL).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- EmailJS (server-side ONLY — never use VITE_* for these) ---
# All four are required for enquiry/reset/confirmation emails; if any is missing
# the API returns 503 { success:false, code:"EMAIL_CONFIG_MISSING" }.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
