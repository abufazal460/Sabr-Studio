# Browser-safe variables ONLY. Never put server secrets here (no VITE_-prefixed secrets).
# Copy to .env for local development. Local dev uses the Vite proxy:
#   VITE_API_BASE_URL=/api  ->  Vite forwards /api to http://127.0.0.1:3000
VITE_API_BASE_URL=/api

# Razorpay PUBLIC key id only (the secret stays on the backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
