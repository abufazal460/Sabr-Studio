# Browser-safe variables ONLY. Never put server secrets here (no VITE_-prefixed secrets).

# API base URL.
#   Production (same-origin):  /api
#   Local dev:                 leave empty (defaults to /api via the Vite proxy)
#                              or set http://localhost:3000/api to call the backend directly
VITE_API_BASE_URL=/api

# Razorpay PUBLIC key id only (the secret stays on the backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
