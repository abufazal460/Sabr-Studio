# Copy to frontend/.env (or set these in the Hostinger/Vercel build environment).
# BROWSER-SAFE variables ONLY. Anything prefixed VITE_ is bundled into the public
# JS — NEVER put MONGODB_URI, JWT_SECRET, payment secret keys, Cloudinary secrets,
# EmailJS private key, or Twilio credentials here.

# API base URL.
#  - Same-domain hosting (Hostinger single Node app, or Vercel): keep "/api".
#  - Separate backend subdomain: use the absolute URL, e.g.
#    VITE_API_BASE_URL=https://api.sabrstudio.in/api
VITE_API_BASE_URL=/api

# Razorpay PUBLIC key id only (the secret stays on the backend).
# NOTE (verified 2026-10-12): no frontend source reads this variable —
# Checkout.jsx uses the `keyId` returned by POST /orders/checkout, so the
# server-side RAZORPAY_KEY_ID is the single source of truth. Kept for
# backward compatibility; safe to leave empty.
VITE_RAZORPAY_KEY_ID=

# Google OAuth 2.0 Client ID (Web application) — the SAME value as the backend
# GOOGLE_CLIENT_ID. Used to render the "Continue with Google" button. The ID
# token it produces is verified server-side; this id is public by design.
# Leave empty to hide Google Sign-In (it then shows a "not configured" notice).
VITE_GOOGLE_CLIENT_ID=
