; Vite, @vitejs/plugin-react, tailwindcss and postcss live in devDependencies,
; but they are REQUIRED to produce the production build.
; Build hosts (e.g. Hostinger) run `npm install` with NODE_ENV=production, which
; makes npm omit devDependencies by default. Without this, `vite` is never
; installed and `npm run build` fails with "sh: line 1: vite: command not found".
include=dev
